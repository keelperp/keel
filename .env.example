# Every variable here exists because something breaks without it.

# Read+write endpoint. BSC mainnet is chain 56.
KEEL_RPC_URL=https://bsc-dataseed.bnbchain.org

# Deploys the factory, the curve and the opening vault set. Becomes the factory's
# curator — the only address that can list new vaults. Use a fresh wallet.
KEEL_DEPLOYER_KEY=

# Immutable on FeeVault. The only address that can lock or sweep protocol fees.
# Separate from the deployer on purpose: ownership can move, custody cannot.
KEEL_CUSTODY=
KEEL_CUSTODY_KEY=

# Where ./exit sends swept protocol fees. Checked before anything is sent.
KEEL_EXIT_RECIPIENT=
